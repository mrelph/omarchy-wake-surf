#!/usr/bin/env python3
"""Fetch WSDOT 520 bridge camera stills to a local cache directory.

The panel used to point QML's Image straight at
https://images.wsdot.wa.gov/nw/<id>.jpg, which stopped rendering when WSDOT
rotated that host's certificate (issued 2026-02-17): the server now sends
only its leaf certificate and omits the "DigiCert EV RSA CA G2" intermediate
that signed it. Browsers paper over this by caching intermediates and by
following the leaf's AIA URL; Qt's network stack does neither, so every
camera Image failed its TLS handshake and drew nothing, silently.

Rather than depend on a system-wide trust change, this script completes the
chain itself with the intermediate pinned below and writes the JPEGs to disk
for the panel to load over file://. The pinned certificate is a public
DigiCert intermediate that already chains to "DigiCert Global Root G2" in the
system store, so trusting it here grants no authority the system store didn't
already imply -- and it is scoped to this script, which only ever talks to
IMAGE_HOST.

If WSDOT fixes its chain, the pin becomes harmless dead weight rather than a
breakage: verification succeeds either way.
"""

from __future__ import annotations

import argparse
import os
import ssl
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

IMAGE_HOST = "images.wsdot.wa.gov"
IMAGE_URL = "https://" + IMAGE_HOST + "/nw/{camera_id}.jpg"
USER_AGENT = "Mozilla/5.0 (wake-surf-widget; personal desktop use)"

DEFAULT_CAMERA_IDS = ["520vc00241", "520vc00293", "520vc00341"]

# DigiCert EV RSA CA G2 -- the intermediate images.wsdot.wa.gov names as its
# issuer but no longer sends. Valid 2020-07-02 through 2030-07-02.
# SHA-256: 9588EF74199E45ACEFCCCFC0C47010E9F2A37A1DD44C61A4E1C6B334DA5AF614
WSDOT_ISSUER_PEM = """\
