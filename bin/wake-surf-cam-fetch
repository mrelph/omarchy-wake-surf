def build_ssl_context() -> ssl.SSLContext:
    context = ssl.create_default_context()
    context.load_default_certs()
    context.load_verify_locations(cadata=WSDOT_ISSUER_PEM)
    return context


def fetch_camera(camera_id: str, context: ssl.SSLContext, timeout: float) -> bytes | None:
    request = urllib.request.Request(
        IMAGE_URL.format(camera_id=camera_id), headers={"User-Agent": USER_AGENT}
    )
    with urllib.request.urlopen(request, timeout=timeout, context=context) as response:
        if response.status != 200:
            return None
        payload = response.read()
    # WSDOT answers an unknown camera id with an HTML error page rather than a
    # 404, so check for the JPEG magic bytes instead of trusting the status.
    if not payload.startswith(b"\xff\xd8\xff"):
        return None
    return payload


def write_atomically(destination: Path, payload: bytes) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix="." + destination.stem + "-", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(payload)
        os.replace(temp_path, destination)
    finally:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def main() -> int:
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    default_output_dir = state_home / "omarchy/wake-surf/cams"

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("camera_ids", nargs="*", default=None,
                        help="WSDOT camera ids (default: the three 520 bridge cams)")
    parser.add_argument("--output-dir", type=Path, default=default_output_dir)
    parser.add_argument("--timeout", type=float, default=8.0)
    args = parser.parse_args()

    camera_ids = args.camera_ids or DEFAULT_CAMERA_IDS
    context = build_ssl_context()

    failures = 0
    for camera_id in camera_ids:
        try:
            payload = fetch_camera(camera_id, context, args.timeout)
        except (urllib.error.URLError, ssl.SSLError, TimeoutError, OSError) as error:
            print("wake-surf-cam-fetch: " + camera_id + ": " + str(error), file=sys.stderr)
            payload = None
        if payload is None:
            # Leave whatever still is already cached in place; a stale frame
            # beats an empty tile for a transient network blip.
            failures += 1
            continue
        write_atomically(args.output_dir / (camera_id + ".jpg"), payload)

    return 0 if failures == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
